.env
__pycache__/
*.pyc
.venv/
venv/

# large/raw pulled docs and processed artifacts -- regenerable via scripts/ingest.py
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/retrieval_eval_results.json
!data/processed/generation_eval_results.json
!data/processed/ragas_comparison_results.json
!data/processed/security_eval_results.json
!data/processed/ablation_results.json
!data/processed/full_ablation_matrix.json
!data/processed/reranker_finetune_results.json
# chunks.json is required at container/Space boot (BM25 index) -- without it
# tracked, a fresh clone builds a container that boots in degraded mode
# (see app/api/main.py's lifespan hook). Small (~1MB), safe to track plainly.
!data/processed/chunks.json

# Model checkpoints -- except the fine-tuned reranker, which IS tracked (via
# Git LFS for the large weight file, see .gitattributes) since it's now
# actually loaded by app/retrieval/hybrid.py at runtime, not just an eval
# artifact.
models/*
!models/fastapi-reranker-minilm/
checkpoints/

.pytest_cache/
